# ===========================================
# Wellness Point - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values

# ---------- App ----------
NEXT_PUBLIC_APP_URL=https://wellness-point.in
NEXT_PUBLIC_APP_NAME=Wellness Point

# ---------- MongoDB ----------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/wellness-point?retryWrites=true&w=majority

# ---------- NextAuth ----------
NEXTAUTH_URL=https://wellness-point.in
NEXTAUTH_SECRET=your-nextauth-secret-key-change-this

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---------- Facebook OAuth ----------
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ---------- JWT (for custom token signing) ----------
JWT_SECRET=your-jwt-secret-key-change-this

# ---------- Admin Seed ----------
ADMIN_EMAIL=admin@wellness-point.in
ADMIN_PASSWORD=Admin@12345
